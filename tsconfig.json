{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./generated/*"
      ],
      "@demo/*": [
        "./*"
      ]
    },
    "target": "ES2017",
    "allowImportingTsExtensions": true
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "mock/**/*.ts",
    "mock/**/*.tsx",
    "generated/components/**/*.ts",
    "generated/components/**/*.tsx",
    "generated/hooks/**/*.ts",
    "generated/hooks/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "out",
    "public",
    "generated/components/**/*.test.*",
    "generated/hooks/**/*.test.*"
  ]
}
