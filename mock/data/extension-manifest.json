            "feat.display.title": "Show session title row",
            "feat.display.input": "Show current input row",
            "feat.display.opacity": "Banner opacity",
            "feat.text.maxLen": "Text truncation length",
            "anchor.currentInput": "Current input",
            "anchor.firstInput": "First input",
            "anchor.latestInput": "Latest input",
            "anchor.sessionTitle": "Session title",
            "anchor.hint": "Click to jump to this input"
          }
        }
      },
      "source": "bundled",
      "icon": "icon.svg",
      "features": [
        {
          "id": "show.banner",
          "label": "显示消息锚点横幅",
          "description": "消息区顶部常驻横幅，展示当前视口所属的用户输入",
          "default": true,
          "enabled": true
        },
        {
          "id": "display.mode",
          "type": "string",
          "label": "显示模式",
          "group": "内容",
          "description": "current=当前视口所属的用户输入（滚动跟随）；first=会话第一条输入；latest=最近一条输入；title=会话标题",
          "value": "current",
          "placeholder": "current",
          "enabled": true
        },
        {
          "id": "display.title",
          "label": "显示会话标题行",
          "group": "内容",
          "description": "横幅第一行显示当前会话标题（name，无则显示会话第一条输入）",
          "default": true,
          "enabled": true
        },
        {
          "id": "display.input",
          "label": "显示当前输入行",
          "group": "内容",
          "description": "横幅第二行显示当前视口所属的用户输入（display.mode 决定的输入）",
          "default": true,
          "enabled": true
        },
        {
          "id": "display.opacity",
          "type": "string",
          "label": "横幅透明度",
          "group": "样式",
          "description": "横幅不透明度（0-100 数字：0=全透明，100=不透明；默认 85，能看到但不干扰）",
          "value": "85",
          "placeholder": "85",
          "enabled": true
        },
        {
          "id": "text.maxLen",
          "type": "string",
          "label": "文本截断长度",
          "group": "内容",
          "description": "横幅里用户输入/标题最多显示的字符数（超出省略号；0 或非法值回退 140）",
          "value": "140",
          "placeholder": "140",
          "enabled": true
        }
      ]
    },
