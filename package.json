{
  "name": "@aiti-ai/aiti-demos",
  "version": "0.1.0",
  "private": true,
  "description": "Static, backend-free showcase of the AITI Web workbench: the real fork UI plus the real extension host, with a complete recorded mock model.",
  "scripts": {
    "sync": "node scripts/sync-frontend.mjs",
    "sync:check": "node scripts/sync-frontend.mjs --check",
    "prepare:files": "node scripts/prepare-demo-files.mjs",
    "predev": "npm run sync && npm run extensions && npm run prepare:files",
    "dev": "next dev -H 127.0.0.1 -p 30146",
    "prebuild": "npm run sync && npm run extensions && npm run prepare:files",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "capture": "node capture/run.mjs",
    "capture:install": "playwright install chromium",
    "compile": "node capture/compile.mjs",
    "audit": "node scripts/audit-fixtures.mjs",
    "coverage": "node scripts/check-coverage.mjs",
    "tour": "node scripts/tour.mjs",
    "extensions": "node scripts/build-extension-manifest.mjs",
    "capture:install:cn": "bash scripts/install-playwright-browser.sh"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.6.0",
    "@earendil-works/pi-ai": "1.6.0",
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "ansi_up": "^6.0.6",
    "js-yaml": "^5.2.3",
    "katex": "^0.16.47",
    "mermaid": "^11.16.1",
    "next": "16.3.6",
    "partial-json": "0.1.7",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-cjk-friendly": "^2.3.2",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "jiti": "^2.7.0",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.2.2",
    "typescript": "^5"
  },
  "overrides": {
    "eslint-plugin-react-hooks": "7.0.1"
  }
}
